rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── STAFF COLLECTION (Web-only) ────────────────────────────────
    // Only authenticated staff can read (admin verified on frontend)
    // Only backend with Admin SDK can create/update staff accounts
    match /staff/{uid} {
      // Authenticated staff members can read all staff profiles (admin access enforced on frontend)
      allow read: if request.auth != null;
      // Staff cannot write their own profiles (only backend/admin can update)
      allow write: if false;
    }

    // ─── USERS COLLECTION (Mobile users) ────────────────────────────
    // Mobile users can CRUD their own profiles
    match /users/{uid} {
      // Authenticated users can read their own profile
      allow read: if request.auth.uid == uid;
      // Users can create their profile with required fields
      allow create: if request.auth.uid == uid &&
                       request.resource.data.keys().hasAll(['firstName', 'lastName', 'email']);
      // Users can update their profile
      allow update: if request.auth.uid == uid;
      // Users can delete their profile
      allow delete: if request.auth.uid == uid;
    }

    // ─── REPORTS COLLECTION ────────────────────────────────────────────
    // Only backend (admin) can create reports
    // Staff (web) can read all reports and update case management fields
    // Mobile users cannot directly access reports (backend handles submission)
    match /reports/{reportId} {
      // Staff can read all reports
      allow read: if get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      // Staff can update case management fields
      allow update: if get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'] &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'priorityLevel', 'assignedOfficer', 'updatedAt']);
      // Only backend with Admin SDK can create reports
      allow create: if false;
      // Reports cannot be deleted
      allow delete: if false;
    }

    // ─── DEFAULT DENY ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
