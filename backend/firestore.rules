rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── STAFF COLLECTION (Web-only) ────────────────────────────────
    // Unauthenticated reads allowed for login (username lookup)
    // Only backend with Admin SDK can create/update staff accounts
    match /staff/{uid} {
      // Allow all reads (unauthenticated for login, authenticated for admin access)
      allow read: if true;
      // Allow staff to update only their own lastLogin field.
      allow update: if request.auth.uid == uid &&
                    request.resource.data.keys().hasOnly(['lastLogin']);
      // Staff cannot write other profile fields directly from the client.
      allow write: if false;
    }

    // ─── USERS COLLECTION (Mobile users) ────────────────────────────
    // Mobile users can CRUD their own profiles
    match /users/{uid} {
      // Authenticated users can read their own profile
      allow read: if request.auth.uid == uid;
      // Users can create their profile with required fields
      allow create: if request.auth.uid == uid &&
                       request.resource.data.keys().hasAll(['firstName', 'lastName', 'email']);
      // Users can update their profile
      allow update: if request.auth.uid == uid;
      // Users can delete their profile
      allow delete: if request.auth.uid == uid;
    }

    // ─── REFERRALS COLLECTION ────────────────────────────────────────
    // Staff can view and create referral records from the web app
    match /referrals/{referralId} {
      allow read: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      allow create: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'] &&
                       request.resource.data.keys().hasAll(['caseId', 'caseNumber', 'referredTo', 'reason', 'status', 'createdAt', 'createdBy', 'createdByName']);
      allow update: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      allow delete: if false;
    }

    // ─── REPORTS COLLECTION ────────────────────────────────────────────
    // Only backend (admin) can create reports
    // Staff (web) can read all reports and update case management fields
    // Mobile users can read their own reports
    match /reports/{reportId} {
      // Staff can read all reports
      allow read: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                     get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      // Mobile users can read their own reports (where uid matches)
      allow read: if request.auth.uid == resource.data.uid;

      match /interviews/{interviewId} {
        allow read, create: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                              get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
        allow update: if resource.data.officerUid == request.auth.uid;
        allow delete: if false;
      }

      // ─── RESOLUTIONS SUBCOLLECTION ────────────────────────────────
      // Officers submit resolutions for their assigned cases
      // Admins review and approve/reject resolutions
      match /resolutions/{resolutionId} {
        allow read: if (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'officer') ||
                       (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin');
        allow create: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'officer';
        allow update: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'admin';
        allow delete: if false;
      }

      // ─── ACTIVITY LOG SUBCOLLECTION ────────────────────────────────
      // Staff can read activity logs
      // Only backend can create activity logs
      match /activityLog/{logId} {
        allow read: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
        allow create: if false;
        allow delete: if false;
      }

      // Staff can update case management fields (including new statuses and referrals)
      allow update: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'] &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'priorityLevel', 'assignedOfficer', 'updatedAt', 'referredTo', 'referralReason']);
      // Only backend with Admin SDK can create reports
      allow create: if false;
      // Reports cannot be deleted
      allow delete: if false;
    }

    // ─── MESSAGES COLLECTION (with subcollections by case) ────────────────
    // Messages organized as: messages/{caseId}/messages/{messageId}
    // Officers and reporters can send/read messages for assigned cases
    match /messages/{caseId} {
      // Allow subcollection reads/writes for authenticated users
      match /messages/{messageId} {
        // Allow read if:
        // 1. User is a staff member (officer/admin), OR
        // 2. User is the reporter for this message, OR
        // 3. User is the officer who sent this message
        allow read: if (exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                         get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer']) ||
                       (request.auth.uid == resource.data.reporterUid) ||
                       (request.auth.uid == resource.data.officerUid);
        // Allow create if:
        // 1. User is staff and sending as officer, OR
        // 2. User is the reporter sending as reporter
        allow create: if ((exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                           get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer']) &&
                          (request.resource.data.from == 'officer')) ||
                         ((request.auth.uid == request.resource.data.reporterUid) &&
                          (request.resource.data.from == 'reporter'));
        // Cannot update or delete messages
        allow update: if false;
        allow delete: if false;
      }
    }

    // ─── NOTIFICATIONS COLLECTION ──────────────────────────────
    // Staff can read and update their own notifications
    // Only backend with Admin SDK can create notifications
    match /notifications/{notificationId} {
      // Staff can read their own notifications
      allow read: if request.auth.uid == resource.data.recipientUid;
      // Staff can update notifications (mark as read)
      allow update: if request.auth.uid == resource.data.recipientUid;
      // Only backend can create notifications
      allow create: if false;
      // Cannot delete notifications
      allow delete: if false;
    }

    // ─── ACCESS LOGS COLLECTION ─────────────────────────────
    // Let staff/officers create access logs for audit trail.
    match /access_logs/{logId} {
      allow read: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                    get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      allow create: if exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
                      get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'officer'];
      allow update: if false;
      allow delete: if false;
    }

    // ─── DEFAULT DENY ──────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
