# Supabase environment variables for backend
# Set SUPABASE_URL to your Supabase project URL (e.g. https://xyz.supabase.co)
# Set SUPABASE_SERVICE_ROLE_KEY to the service role key (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (Optional) If you still use Firebase Admin for other purposes, set FIREBASE_CREDENTIALS
# FIREBASE_CREDENTIALS can be the JSON content of the service account or leave empty.
FIREBASE_CREDENTIALS=
# Copy this file to .env and replace the placeholder values with your Cloudinary account details.

FIREBASE_CREDENTIALS={}
EMAIL_USER=noreply.violess@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
PORT=5000
